server {
  listen 5173;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

  # Locations below add their own Cache-Control; these still go out with them.
  add_header_inherit merge;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # The settings of this environment, which the app reads before it starts.
  # The values come from the container's variables each time it starts.
  location = /config.js {
    default_type text/javascript;
    add_header Cache-Control "no-store";
    return 200 'window.__ENV__ = { VITE_DEMO_MODE: "${VITE_DEMO_MODE}", VITE_API_URL: "${VITE_API_URL}", VITE_KEYCLOAK_URL: "${VITE_KEYCLOAK_URL}", VITE_KEYCLOAK_REALM: "${VITE_KEYCLOAK_REALM}", VITE_KEYCLOAK_CLIENT_ID: "${VITE_KEYCLOAK_CLIENT_ID}" };\n';
  }

  # File names carry a hash of their content, so they can be cached for good.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Routes are resolved in the browser: any other address gets the app.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }

  location = /healthz {
    access_log off;
    return 204;
  }
}
